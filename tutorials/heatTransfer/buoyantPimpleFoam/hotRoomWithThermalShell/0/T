FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    "floor.*"
    {
        type            fixedValue;
        value           uniform 700;
    }

    "ceiling.*"
    {
        type                compressible::thermalShell;
        active              true;

        region              upper;
        thermalShellModel   thermalShell;

        thermo
        {
            // Thermal properties
            rho             1000;
            kappa           200;
            Cp              600;
            emissivity      0;
        }

        thickness           1e-3;

        //suffixing       default; //
        //suffixing       _shell;  //

        // Primary field
        // Tprimary            T;

        //default: T       Ts;
        //default: h       hs;
        //default: qr      qr;

        value               uniform 300;
    }

    "fixedWall.*"
    {
        type            zeroGradient;
    }
}


