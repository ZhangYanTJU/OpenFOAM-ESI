FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      faOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// For externalHeatFluxSource:

outside
{
    type            externalHeatFluxSource;
    active          true;
    region          upper;
    selectionMode   all;

    T               Ts;
    //suffixing       default;
    //suffixing       _shell;   // If used for region-model

    mode            coefficient;
    Ta              constant 290;
    h               10;
}

// contactHeatFluxSource is the coupling of the shell-2D and the 3D mesh
contact
{
    type            contactHeatFluxSource;
    active          true;
    region          upper;
    selectionMode   all;

    T               Ts;
    Tprimary        T;

    //suffixing       default;
    //suffixing       _shell;   // If used for region-model

    kappaMethod     fluidThermo;

    thicknessLayers (0.001);
    kappaLayers     (0.02);
}


